# Copy this file to .env.local
# Replace the placeholder values below before running the app.

# Admin portal credentials
ADMIN_SLUG=mark-admin-2026
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SECRET_KEY=change_this_secret_key
JWT_SECRET=replace_with_a_long_random_jwt_secret

# After running `npx convex dev`, replace the placeholder with your actual Convex URL.
# Your Convex deployment URL will look like:
# NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud
